{
  "name": "agents-monitor",
  "version": "0.2.1",
  "description": "Alternativa leve ao savvy-progress: faixa acima do prompt e painel /monitor com agentes em pixel, etapas, tempo, custo e contexto.",
  "author": {
    "name": "ThiagoLimaf",
    "url": "https://github.com/ThiagoLimaf"
  },
  "license": "MIT",
  "homepage": "https://github.com/ThiagoLimaf/claude-agents-monitor/tree/main/plugins/agents-monitor",
  "repository": "https://github.com/ThiagoLimaf/claude-agents-monitor",
  "types": "./types/index.d.ts",
  "userConfig": {
    "language": {
      "type": "string",
      "title": "Idioma",
      "description": "pt (Português) ou en (English)",
      "default": "pt",
      "options": [
        "pt",
        "en"
      ]
    },
    "autoOpen": {
      "type": "string",
      "title": "Abrir o painel do monitor",
      "description": "subagents: quando um subagente começa, uma vez por turno; never: só com /monitor",
      "default": "subagents",
      "options": [
        "subagents",
        "never"
      ]
    }
  }
}
